# Lukis settings for docker compose.
#
# Copy this file to .env (next to compose.yaml) and uncomment what you need.
# Nothing here is required to try Lukis on your own computer. After changing
# it, run `docker compose up -d` again. Full guide: docs/self-hosting.md
#
# Values go into URLs and shell-like files, so stick to letters, digits,
# dashes and dots in passwords and keys (no $, # or quotes).


# ── Where people reach Lukis ────────────────────────────────────────────────

# The address people type into their browser, with no trailing slash.
# Default: http://localhost:3000
# PUBLIC_URL=https://draw.example.com

# The port the app is published on. By default only this computer can reach
# it. To open it to your network, use LUKIS_PORT=3000 and set PUBLIC_URL to
# http://<this machine's IP>:3000.
# LUKIS_PORT=127.0.0.1:3000

# Optional extras, comma-separated:
# - caddy:  HTTPS on ports 80 and 443 with free Let's Encrypt certificates.
#           Point your domain's DNS at this server and set PUBLIC_URL to
#           https://<your domain>.
# - backup: a database backup to object storage every day.
# COMPOSE_PROFILES=caddy,backup

# Behind a Cloudflare Tunnel, Caddy should serve plain HTTP: use ":80" (and
# point the tunnel at http://localhost:80).
# CADDY_ADDRESS=:80


# ── The first account ───────────────────────────────────────────────────────

# The first account becomes the site owner, and needs a one-time setup code
# to register, so a stranger can't claim a fresh install. By default a random
# code is printed in `docker compose logs backend`; set one here instead
# (8 or more letters and digits).
# SETUP_CODE=


# ── Email (optional) ────────────────────────────────────────────────────────

# With email, Lukis confirms new addresses, offers password reset and emails
# invites. Without it, invites are links you copy and send yourself.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none.
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=Lukis <noreply@draw.example.com>


# ── Log in with Google, GitHub or Microsoft (optional) ──────────────────────

# Each one appears on the login page once its client ID and secret are set.
# Redirect URI to register with each: PUBLIC_URL/api/auth/oauth/<provider>/callback
# where <provider> is google, github or microsoft.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# common (any Microsoft account), organizations, consumers, or a tenant ID.
# MICROSOFT_TENANT=common


# ── Object storage ──────────────────────────────────────────────────────────

# Keys for the bundled storage. It's never published outside Docker, but you
# can choose your own before the first start. Changing them later locks the
# backend out of files already stored.
# S3_ACCESS_KEY=lukis
# S3_SECRET_KEY=lukis-storage-secret

# Or use S3-compatible storage you already have (AWS S3, Cloudflare R2,
# MinIO…). Add docker/compose.own-storage.yaml to COMPOSE_FILE (below) so the
# bundled one isn't started, and fill these in along with the keys above.
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_BUCKET=lukis
# S3_REGION=eu-central-1


# ── Database ────────────────────────────────────────────────────────────────

# Or a MongoDB you already run (7.0 or newer). Add
# docker/compose.own-mongo.yaml to COMPOSE_FILE so the bundled one isn't
# started. One on this machine itself is host.docker.internal.
# MONGO_URL=mongodb://lukis:<password>@host.docker.internal:27017/?authSource=admin
# MONGO_DB=lukis

# Extra compose files, separated by colons (semicolons on Windows).
# COMPOSE_FILE=compose.yaml:docker/compose.own-storage.yaml:docker/compose.own-mongo.yaml


# ── Backups (with the "backup" profile) ─────────────────────────────────────

# Backups go under backups/ in the storage bucket, or in BACKUP_BUCKET.
# BACKUP_KEEP_DAYS=14
# BACKUP_BUCKET=


# ── Versions ────────────────────────────────────────────────────────────────

# Which images to run: "latest", or a "sha-<short commit>" tag from the repo's
# Packages page to pin a version or roll back.
# FRONTEND_TAG=latest
# BACKEND_TAG=latest
